# ---------- Copy to .env for local runs, or paste into Railway → Variables (Raw Editor) ----------

# simulation | hybrid | live  (the UI toggle overrides this per session)
EXECUTION_MODE=simulation
# Your public HTTPS URL, e.g. https://your-app.up.railway.app (Railway → Settings → Networking → Generate Domain).
# Bolna calls the tool webhooks here. If empty, the app uses the URL you opened it from.
PUBLIC_BASE_URL=

# ---- Google AI Studio (Gemini): optional. Gives simulated vendors natural wording + parses spoken briefs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Bolna (needed only for hybrid/live) ----
BOLNA_API_KEY=
# Filled after you tap ⚙︎ Setup → "Create / update Bolna agents" (it prints this line for you):
BOLNA_AGENT_IDS=
# Telephony provider configured on your Bolna account: plivo | exotel | twilio
BOLNA_TELEPHONY_PROVIDER=plivo
# Optional: one of your Bolna numbers (E.164). Empty = Bolna's default number.
BOLNA_FROM_NUMBER=
BOLNA_LLM_PROVIDER=openai
BOLNA_LLM_MODEL=gpt-4.1-mini
BOLNA_AGENT_LANGUAGES=hi,kn
# "var" ({"$var": "x"} markers) or "legacy" ("%(x)s" templates) for tool params
BOLNA_TOOL_PARAM_STYLE=var

# Shared secret Bolna sends on tool calls (Authorization: Bearer ...). Any long random string.
TOOL_SHARED_SECRET=
# Protects the ⚙︎ Setup endpoints. Any long random string.
ADMIN_TOKEN=

# ---- Phones ----
# Hybrid mode: your own Android number (you play Vendor A)
LIVE_TEST_PHONE=
# Live mode: comma-separated real vendor numbers
LIVE_VENDOR_PHONES=

# ---- Payments / WhatsApp (optional; mock checkout + wa.me link otherwise) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
TOKEN_ADVANCE_PERCENT=10
BUYER_WHATSAPP=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---- Tuning ----
WAVE_STAGGER_SECONDS=8
HYBRID_LIVE_DELAY_SECONDS=6
# >1 speeds up simulated vendors (useful for rehearsals); 1 = realistic pacing
SIM_SPEED=1
DB_PATH=data/auction.db
