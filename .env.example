# ---------- Copy to .env for local runs, or paste into Railway → Variables (Raw Editor) ----------

# simulation | hybrid | live  (the UI toggle overrides this per session)
EXECUTION_MODE=simulation
# Your public HTTPS URL, e.g. https://your-app.up.railway.app (Railway → Settings → Networking → Generate Domain).
# Bolna calls the tool webhooks here. If empty: Railway's RAILWAY_PUBLIC_DOMAIN / Render's RENDER_EXTERNAL_URL.
PUBLIC_BASE_URL=

# ---- Google AI Studio (Gemini): optional. Gives simulated vendors natural wording + parses spoken briefs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Gemini rewording of simulated calls (~25 requests/run). The free tier allows ~20 requests/day/model.
SIM_LLM_REPHRASE=false

# ---- Bolna (needed only for hybrid/live) ----
BOLNA_API_KEY=
# Create/update the Bolna agents automatically on every boot (needs BOLNA_API_KEY + a public URL)
AUTO_SYNC_BOLNA_AGENT=true
# Optional: pin agent ids. Printed by ⚙︎ Setup → "Create / update Bolna agents" (it prints this line for you):
BOLNA_AGENT_IDS=
# Telephony provider configured on your Bolna account: plivo | exotel | twilio
BOLNA_TELEPHONY_PROVIDER=plivo
# Optional: one of your Bolna numbers (E.164). Empty = Bolna's default number.
BOLNA_FROM_NUMBER=
BOLNA_LLM_PROVIDER=openai
# gpt-5.4-mini = Bolna's recommended voice LLM (fastest TTFT); auto-falls back to gpt-4.1-mini if rejected
BOLNA_LLM_MODEL=gpt-5.4-mini
BOLNA_LLM_REASONING_EFFORT=none
BOLNA_LLM_VERBOSITY=low
# If Bolna rejects the model: first only the rejected setting is dropped, then these are tried in order.
# The exact Bolna error is logged and shown in ⚙︎ Setup → Call LLM.
BOLNA_LLM_FALLBACK_MODELS=gpt-4.1
BOLNA_LLM_FALLBACK_MODEL=gpt-4.1-mini
BOLNA_AGENT_LANGUAGES=hi,kn
# Sarvam voice used by the Bolna agent (bulbul:v2 is retired). Speaker names are lowercase.
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE=shubh
SARVAM_ASR_MODEL=saaras:v4
# "var" ({"$var": "x"} markers) or "legacy" ("%(x)s" templates) for tool params
BOLNA_TOOL_PARAM_STYLE=var

# Shared secret Bolna sends on tool calls (Authorization: Bearer ...). Any long random string.
TOOL_SHARED_SECRET=
# Protects the ⚙︎ Setup endpoints. Any long random string.
ADMIN_TOKEN=

# ---- Provider search (any service) ----
# Google Maps Platform key with "Places API (New)" enabled (real ratings, phones, website, hours). Optional.
# Restrict it to "Places API (New)" in Cloud Console. Never commit it: this repo is public.
GOOGLE_MAPS_API_KEY=
# SAFETY: false = every provider is dialled on the test phone instead of the business
CALL_REAL_NUMBERS=false
# The ONLY number any provider call rings while CALL_REAL_NUMBERS=false (defaults to LIVE_TEST_PHONE)
TEST_PHONE_OVERRIDE=
# auto | sequential | parallel  (auto = one after another when calls share a phone or exceed 2)
DIAL_STRATEGY=auto

# ---- Phones ----
# Hybrid mode: your own Android number (you play Vendor A)
LIVE_TEST_PHONE=
# Live mode: comma-separated real vendor numbers
LIVE_VENDOR_PHONES=

# ---- Payments / WhatsApp (optional; mock checkout + wa.me link otherwise) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
TOKEN_ADVANCE_PERCENT=10
BUYER_WHATSAPP=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---- Tuning ----
# Per-device hourly limits on what costs money (0 = off): map searches, real-call sessions, chat messages
RATE_LIMIT_SEARCH_PER_HOUR=60
RATE_LIMIT_CALLS_PER_HOUR=20
RATE_LIMIT_CHAT_PER_HOUR=300
# Counter-offers per call before taking the vendor's best price within budget (or walking away above it)
MAX_COUNTER_ROUNDS=1
WAVE_STAGGER_SECONDS=8
HYBRID_LIVE_DELAY_SECONDS=6
# >1 speeds up simulated vendors (useful for rehearsals); 1 = realistic pacing
SIM_SPEED=1
DB_PATH=data/auction.db
